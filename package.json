{
  "name": "web-nikki",
  "type": "module",
  "version": "1.0.0",
  "repository": "https://github.com/geeknees/web-nikki",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "astro check && astro dev",
    "preview": "astro preview",
    "build": "astro check && astro build && pagefind --site dist",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:integration": "node --test --experimental-strip-types tests/integration/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types tests/e2e/*.test.ts",
    "astro": "astro",
    "new-post": "esno scripts/new-post.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/rss": "^4.0.19",
    "@github/clipboard-copy-element": "^1.3.2",
    "astro": "^7.3.8",
    "astro-embed": "^0.7.4",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^0.8.4",
    "markdown-it": "^14.3.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@unocss/reset": "^0.59.4",
    "@unocss/transformer-directives": "^0.63.6",
    "consola": "^3.4.2",
    "esno": "^4.8.0",
    "pagefind": "^1.5.2",
    "unocss": "^0.61.9"
  }
}
